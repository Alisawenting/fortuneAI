.page { background-color: #f5f2ed; min-height: 100vh; }
.header { display: flex; align-items: center; justify-content: space-between; padding-top: 20rpx; padding-bottom: 20rpx; }
.back-btn { width: 72rpx; height: 72rpx; }
.header-title { font-size: 32rpx; font-weight: 500; }

.hero { text-align: center; padding: 60rpx 0; }
.hero-icon { font-size: 80rpx; display: block; }
.hero-title { font-size: 40rpx; font-weight: 600; display: block; margin-top: 24rpx; }
.hero-desc { font-size: 26rpx; color: var(--muted-foreground); margin-top: 12rpx; display: block; }

.plans { display: flex; flex-direction: column; gap: 24rpx; padding-bottom: 120rpx; }
.plan-card {
  padding: 40rpx; border-radius: 32rpx;
  border: 2rpx solid var(--border); background: var(--card);
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
  position: relative;
}
.plan-card.recommended { border-color: var(--primary); background: linear-gradient(135deg, rgba(139,92,246,0.05), var(--card)); }
.plan-recommend {
  position: absolute; top: -2rpx; right: 40rpx;
  padding: 8rpx 24rpx; border-radius: 0 0 16rpx 16rpx;
  background: var(--primary); color: white; font-size: 22rpx;
}
.plan-name { font-size: 32rpx; font-weight: 600; display: block; }
.plan-price { font-size: 56rpx; font-weight: 700; color: var(--primary); margin-top: 16rpx; display: block; }
.plan-period { font-size: 24rpx; color: var(--muted-foreground); font-weight: 400; }
.plan-features { margin-top: 24rpx; display: flex; flex-direction: column; gap: 12rpx; }
.plan-feat { font-size: 26rpx; color: var(--muted-foreground); }

.plan-btn {
  width: 100%; margin-top: 32rpx; padding: 28rpx;
  border-radius: 24rpx; font-size: 28rpx; font-weight: 500; border: none;
}
.plan-btn.primary { background: var(--primary); color: var(--primary-foreground); }
