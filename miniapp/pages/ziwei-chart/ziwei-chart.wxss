.page{background:#f5f2ed;min-height:100vh}
.header{display:flex;align-items:center;justify-content:space-between;padding-top:20rpx;padding-bottom:20rpx}
.back-btn{width:72rpx;height:72rpx;border-radius:50%;background:#fff;box-shadow:0 2rpx 16rpx rgba(0,0,0,.04);display:flex;align-items:center;justify-content:center;font-size:32rpx;text-decoration:none;color:#1f2937}
.header-title{font-size:32rpx;font-weight:500}

.zw-title{font-size:34rpx;font-weight:600;display:block;margin-bottom:8rpx}
.zw-meta{font-size:22rpx;color:#6b7280;display:block;margin-top:4rpx}

.zw-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6rpx}
.zw-cell{padding:12rpx 6rpx;border-radius:14rpx;border:2rpx solid rgba(0,0,0,.06);background:#fff;position:relative;min-height:100rpx}
.zw-cell.ming{border-color:#8b5cf6;background:rgba(139,92,246,.03)}
.zw-cell.body{border-color:#4a9e6e}
.zw-cell-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6rpx}
.zw-cell-name{font-size:22rpx;font-weight:600}
.zw-cell-branch{font-size:16rpx;color:#6b7280}
.zw-stars{margin-bottom:4rpx}
.zw-major-star{font-size:20rpx;font-weight:600;display:block;color:#8b5cf6;line-height:1.3}
.zw-empty{font-size:18rpx;color:#d1d5db}
.zw-cell-tags{position:absolute;top:-4rpx;right:-4rpx;display:flex;gap:4rpx}
.zw-tag-ming{background:#8b5cf6;color:#fff;font-size:16rpx;padding:2rpx 8rpx;border-radius:12rpx}
.zw-tag-body{background:#4a9e6e;color:#fff;font-size:16rpx;padding:2rpx 8rpx;border-radius:12rpx}
.empty-cell{min-height:100rpx;background:rgba(0,0,0,.02);border-radius:14rpx}
