<view class="page" style="padding-top:{{navBarHeight}}px;padding-bottom:120rpx">
  <view class="header px-5">
    <navigator url="/pages/divine/divine" open-type="switchTab" class="back-btn"><text>←</text></navigator>
    <text class="header-title">紫微斗数 · 命盘</text>
    <view class="back-btn"></view>
  </view>

  <block wx:if="{{!chartData}}">
    <view class="placeholder" style="text-align:center;padding:120rpx 40rpx">
      <text style="font-size:100rpx;display:block">🔮</text>
      <text style="font-size:34rpx;color:#1f2937;display:block;margin-top:20rpx">暂无命盘数据</text>
      <navigator url="/pages/divine/divine" open-type="switchTab" style="display:inline-block;margin-top:32rpx;padding:24rpx 48rpx;background:#8b5cf6;color:#fff;border-radius:28rpx;font-size:30rpx">去测算 →</navigator>
    </view>
  </block>

  <block wx:else>
    <view class="content px-5">
      <view class="section-card">
        <view class="flex items-center justify-between">
          <view>
            <text class="zw-title">{{headerInfo.gender === '男' ? '乾造' : '坤造'}} · 紫微斗数命盘</text>
            <text class="zw-meta">公历 {{headerInfo.solarDate}} · {{headerInfo.time}} · {{headerInfo.zodiac}} · {{headerInfo.sign}}</text>
            <text class="zw-meta">五行局：{{headerInfo.fiveElements}} · 命主：{{headerInfo.soul}} · 身主：{{headerInfo.body}}</text>
          </view>
        </view>
      </view>

      <view class="section-card mt-5">
        <text class="section-title mb-3">十二宫命盘</text>
        <view class="zw-grid">
          <block wx:for="{{grid}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
            <block wx:for="{{row}}" wx:for-item="cell" wx:for-index="ci" wx:key="ci">
              <view wx:if="{{cell}}" class="zw-cell {{cell.isMing ? 'ming' : ''}} {{cell.isBody ? 'body' : ''}}">
                <view class="zw-cell-head"><text class="zw-cell-name">{{cell.name}}</text><text class="zw-cell-branch">{{cell.stem}}{{cell.branch}}</text></view>
                <view class="zw-stars">
                  <text wx:if="{{cell.majorStars.length===0}}" class="zw-empty">空宫</text>
                  <text wx:for="{{cell.majorStars}}" wx:for-item="s" wx:key="*this" class="zw-major-star">{{s}}</text>
                </view>
                <view class="zw-cell-tags">
                  <text wx:if="{{cell.isMing}}" class="zw-tag-ming">命</text>
                  <text wx:if="{{cell.isBody}}" class="zw-tag-body">身</text>
                </view>
              </view>
              <view wx:else class="zw-cell empty-cell"></view>
            </block>
          </block>
        </view>
      </view>
    </view>
  </block>
</view>
