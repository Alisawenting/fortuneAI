.page { background-color: #f5f2ed; min-height: 100vh; }
.header { display: flex; align-items: center; justify-content: space-between; padding-top: 20rpx; padding-bottom: 20rpx; }
.back-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #ffffff; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
}
.header-title { font-size: 32rpx; font-weight: 500; }

.empty { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; text-align: center; }
.empty-icon {
  width: 128rpx; height: 128rpx; border-radius: 32rpx;
  background: rgba(139,92,246,0.1); color: #8b5cf6;
  display: flex; align-items: center; justify-content: center; font-size: 64rpx;
}
.empty-title { font-size: 36rpx; font-weight: 600; margin-top: 40rpx; }
.empty-desc { font-size: 28rpx; color: #6b7280; margin-top: 16rpx; }
.empty-btn {
  margin-top: 48rpx; padding: 24rpx 64rpx; border-radius: 24rpx;
  background: #8b5cf6; color: #ffffff;
  font-size: 28rpx; font-weight: 500; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}

.content { padding-top: 40rpx; padding-bottom: 160rpx; }
.mt-4 { margin-top: 32rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-5 { margin-top: 40rpx; }

/* ===== 命盘头部 ===== */
.rizhu-label { font-size: 36rpx; font-weight: 600; }
.sizhu-summary { font-size: 24rpx; color: #6b7280; margin-top: 4rpx; display: block; }
.date-convert { font-size: 22rpx; color: #6b7280; margin-top: 4rpx; display: block; }
.sx-badge {
  padding: 8rpx 24rpx; border-radius: 9999rpx;
  background: rgba(139,92,246,0.1); font-size: 22rpx; color: #8b5cf6;
}

.tab-switch { display: inline-flex; border-radius: 9999rpx; background: #f3f4f6; padding: 4rpx; }
.tab-btn {
  padding: 12rpx 24rpx; border-radius: 9999rpx;
  font-size: 24rpx; color: #6b7280;
}
.tab-btn.active { background: #ffffff; color: #8b5cf6; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04); }

/* ===== 四柱 ===== */
.pillar-headers, .pillar-row {
  display: grid; grid-template-columns: 80rpx 1fr 1fr 1fr 1fr; gap: 12rpx; margin-bottom: 12rpx;
}
.ph-label { font-size: 20rpx; color: #6b7280; display: flex; align-items: center; justify-content: flex-end; }
.pillar-cell {
  padding: 20rpx 8rpx; border: 2rpx solid rgba(0,0,0,0.08);
  border-radius: 16rpx; background: #ffffff;
  text-align: center; position: relative;
}
.pillar-gan { font-size: 48rpx; font-weight: 700; }
.pillar-zhi { font-size: 40rpx; font-weight: 700; }
.pillar-tag {
  position: absolute; top: -8rpx; right: -8rpx;
  padding: 4rpx 12rpx; border-radius: 9999rpx;
  background: #8b5cf6; color: #ffffff; font-size: 18rpx;
}
.pillar-shishen { font-size: 18rpx; color: #8b5cf6; display: block; }
.pillar-canggan, .pillar-nayin { font-size: 18rpx; color: #6b7280; display: block; }

.wuxing-legend { display: flex; justify-content: center; gap: 24rpx; }
.wuxing-dot { font-size: 20rpx; }

.pro-info { padding: 24rpx; border-radius: 24rpx; background: #f3f4f6; font-size: 22rpx; line-height: 2; color: #1f2937; }
.pro-info text { display: block; }

/* ===== 五行进度条 ===== */
.section-title { font-size: 28rpx; font-weight: 500; }
.wx-bar { display: flex; align-items: center; gap: 24rpx; margin-bottom: 20rpx; }
.wx-name { width: 40rpx; font-size: 28rpx; font-weight: 500; }
.wx-track { flex: 1; height: 16rpx; border-radius: 9999rpx; background: #f3f4f6; overflow: hidden; }
.wx-fill { height: 100%; border-radius: 9999rpx; }
.wx-value { width: 64rpx; text-align: right; font-size: 24rpx; color: #6b7280; }

/* ===== 大运 ===== */
.dayun-scroll { white-space: nowrap; padding-bottom: 8rpx; }
.dayun-card {
  display: inline-flex; flex-direction: column;
  min-width: 200rpx; padding: 24rpx; margin-right: 16rpx;
  border-radius: 24rpx; border: 2rpx solid rgba(0,0,0,0.08);
  background: #ffffff; white-space: normal;
}
.dayun-card.active { border-color: #8b5cf6; background: rgba(139,92,246,0.05); }
.dayun-card:active { transform: scale(0.95); }
.dayun-age { font-size: 20rpx; color: #6b7280; }
.dayun-gz { font-size: 28rpx; margin-top: 8rpx; }
.dayun-note { font-size: 20rpx; color: #6b7280; margin-top: 4rpx; }

/* ===== 流年 ===== */
.ln-item { display: flex; align-items: flex-start; gap: 24rpx; padding-left: 24rpx; margin-bottom: 24rpx; }
.ln-left { width: 4rpx; height: 100%; background: rgba(139,92,246,0.4); border-radius: 2rpx; flex-shrink: 0; }
.ln-year { font-size: 28rpx; font-weight: 500; }
.ln-ganzhi { font-size: 22rpx; color: #6b7280; }
.ln-luck { padding: 4rpx 16rpx; border-radius: 9999rpx; font-size: 20rpx; background: #f3f4f6; }
.ln-luck.primary { background: rgba(139,92,246,0.1); color: #8b5cf6; }
.ln-text { font-size: 24rpx; color: #6b7280; margin-top: 8rpx; display: block; line-height: 1.6; }

/* ===== 神煞 ===== */
.shensha-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.ss-card { padding: 24rpx; border-radius: 24rpx; background: #f3f4f6; }
.ss-name { font-size: 28rpx; color: #8b5cf6; }
.ss-pos { font-size: 20rpx; color: #6b7280; }
.ss-desc { font-size: 22rpx; color: #6b7280; margin-top: 8rpx; display: block; line-height: 1.6; }

/* ===== 命格标签 ===== */
.mg-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.mg-tag { padding: 8rpx 24rpx; border-radius: 9999rpx; background: #f3f4f6; font-size: 24rpx; }

/* ===== 生活建议 ===== */
.detail-link { font-size: 24rpx; color: #8b5cf6; }
.life-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.life-card { padding: 24rpx; border-radius: 24rpx; border: 2rpx solid rgba(0,0,0,0.08); }
.life-card:active { transform: scale(0.98); }
.life-icon { font-size: 36rpx; }
.life-title { font-size: 28rpx; font-weight: 500; display: block; margin-top: 16rpx; }
.life-hint { font-size: 22rpx; color: #6b7280; display: block; margin-top: 8rpx; }

/* ===== 商城入口 ===== */
.shop-entry {
  padding: 32rpx; border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(139,92,246,0.1), #ffffff, rgba(196,154,60,0.1));
}
.shop-icon {
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  background: #ffffff; color: #8b5cf6;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}
.shop-title { font-size: 28rpx; font-weight: 500; display: block; }
.shop-desc { font-size: 22rpx; color: #6b7280; display: block; }
.shop-btn {
  margin-top: 24rpx; padding: 20rpx; border-radius: 16rpx;
  background: #8b5cf6; color: #ffffff;
  font-size: 26rpx; font-weight: 500; text-align: center; display: block;
}

/* ===== 弹窗 ===== */
.dayun-dialog-body { font-size: 28rpx; line-height: 2; max-height: 60vh; overflow-y: auto; }
.loading-wrap { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0; font-size: 24rpx; color: #6b7280; }

/* === AI 报告 === */
.section-sub { font-size: 22rpx; color: #6b7280; display: block; }
.report-section { padding: 24rpx; border-radius: 20rpx; border: 2rpx solid rgba(0,0,0,0.06); margin-bottom: 16rpx; background: #f9fafb; }
.rs-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.rs-icon { font-size: 28rpx; }
.rs-title { font-size: 28rpx; font-weight: 600; }
.rs-content { font-size: 26rpx; line-height: 1.8; color: #374151; }

/* === 命理图 === */
.fate-chart-card {
  padding: 40rpx; border-radius: 32rpx; color: #fff;
  background: linear-gradient(160deg, #2d1a4e 0%, #1a1f3a 50%, #3a1a08 100%);
  position: relative; overflow: hidden;
}
.fc-head { display: flex; justify-content: space-between; }
.fc-brand { font-size: 20rpx; opacity: .6; letter-spacing: 4rpx; }
.fc-name { font-size: 40rpx; font-weight: 600; margin-top: 24rpx; }
.fc-meta { font-size: 22rpx; opacity: .6; margin-top: 8rpx; }
.fc-pillars { margin-top: 40rpx; }
.fcp-row { display: flex; gap: 12rpx; align-items: center; margin-bottom: 12rpx; }
.fcp-label { width: 36rpx; font-size: 16rpx; opacity: .4; text-align: right; }
.fcp-hdr { flex: 1; text-align: center; font-size: 18rpx; opacity: .4; }
.fcp-gan { flex: 1; text-align: center; font-size: 38rpx; font-weight: 700; }
.fcp-zhi { flex: 1; text-align: center; font-size: 34rpx; font-weight: 600; }
.fc-elements { display: flex; justify-content: space-around; margin-top: 40rpx; }
.fce-item { text-align: center; }
.fc-info { margin-top: 40rpx; padding: 24rpx; border-radius: 20rpx; background: rgba(255,255,255,.05); font-size: 22rpx; opacity: .7; }
.fc-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.1); }
.fc-ftext { font-size: 20rpx; opacity: .5; }
.fc-qr { width: 64rpx; height: 64rpx; background: rgba(255,255,255,.9); color: #000; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 18rpx; }
.btn-save, .btn-share { flex: 1; padding: 26rpx; border-radius: 24rpx; font-size: 28rpx; font-weight: 500; text-align: center; }
.btn-save { background: #ffffff; border: 2rpx solid rgba(0,0,0,0.08); }
.btn-share { background: #8b5cf6; color: #fff; }
