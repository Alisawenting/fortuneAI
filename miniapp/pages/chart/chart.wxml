<view class="page" style="padding-top:{{navBarHeight}}px;padding-bottom:120rpx">
  <view class="header px-5">
    <navigator url="/pages/divine/divine" open-type="switchTab" class="back-btn"><text>←</text></navigator>
    <text class="header-title">我的命盘</text>
    <view class="back-btn" bindtap="onBookmark"><text>🔖</text></view>
  </view>

  <block wx:if="{{!paipanData}}">
    <view class="empty">
      <view class="empty-icon">✦</view>
      <text class="empty-title">尚未排盘</text>
      <text class="empty-desc">请先录入生辰信息，生成您的专属命盘</text>
      <navigator url="/pages/divine/divine" open-type="switchTab" class="empty-btn">开始测算 →</navigator>
    </view>
  </block>

  <block wx:else>
    <view class="content px-5">
      <!-- 命盘头部 -->
      <view class="section-card">
        <view class="flex items-center justify-between">
          <view>
            <text class="rizhu-label">{{rizhuLabel}} · {{rizhuDesc}}</text>
            <text class="sizhu-summary">{{sizhuSummary}}</text>
            <text class="date-convert" wx:if="{{calendarInfo}}">📅 {{calendarInfo}}</text>
          </view>
          <text class="sx-badge">{{shengxiao}} · {{xingzuo}}</text>
        </view>

        <!-- 基础/专业切换 -->
        <view class="tab-switch mt-4">
          <view class="tab-btn {{tab === 'basic' ? 'active' : ''}}" bindtap="switchTab" data-tab="basic">基础排盘</view>
          <view class="tab-btn {{tab === 'pro' ? 'active' : ''}}" bindtap="switchTab" data-tab="pro">专业细盘</view>
        </view>

        <!-- 四柱 -->
        <view class="mt-4">
          <view class="pillar-headers">
            <text class="ph-label"></text>
            <text class="ph-label" wx:for="{{pillars}}" wx:key="label">{{item.label}}</text>
          </view>
          <view class="pillar-row">
            <text class="ph-label">天干</text>
            <view class="pillar-cell" wx:for="{{pillars}}" wx:key="label">
              <text class="pillar-gan" style="color: {{item.ganColor}}">{{item.gan}}</text>
              <text class="pillar-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
            </view>
          </view>
          <view class="pillar-row">
            <text class="ph-label">地支</text>
            <view class="pillar-cell" wx:for="{{pillars}}" wx:key="label">
              <text class="pillar-zhi" style="color: {{item.zhiColor}}">{{item.zhi}}</text>
            </view>
          </view>
          <view class="pillar-row" wx:if="{{tab === 'pro'}}">
            <text class="ph-label">十神</text>
            <view class="pillar-cell" wx:for="{{pillars}}" wx:key="label">
              <text class="pillar-shishen">{{item.shishen}}</text>
              <text class="pillar-canggan" wx:if="{{item.hidden}}">藏：{{item.hidden}}</text>
              <text class="pillar-nayin">{{item.nayin}}</text>
            </view>
          </view>
        </view>

        <!-- 五行颜色图例 -->
        <view class="wuxing-legend mt-3">
          <text class="wuxing-dot" wx:for="{{wuxingList}}" wx:key="name" style="color: {{item.color}}">● {{item.name}}</text>
        </view>

        <!-- 专业模式额外信息 -->
        <view class="pro-info mt-3" wx:if="{{tab === 'pro'}}">
          <text>• 格局：{{zhengge || '—'}}　• 纳音：{{overallNayin || '—'}}</text>
          <text>• 日主：{{rizhuDesc || '—'}}　• 喜用神：{{xiyongshen || '—'}}</text>
          <text>• 藏干：{{cangganStr || '—'}}</text>
          <text>• 空亡：{{xunkongStr || '—'}}</text>
          <text wx:if="{{chengguInfo}}">• 称骨：{{chengguInfo}}</text>
        </view>
      </view>

      <!-- 五行强弱 -->
      <view class="section-card mt-5">
        <view class="flex items-center justify-between">
          <text class="section-title">五行强弱</text>
        </view>
        <view class="wuxing-bars mt-4">
          <view class="wx-bar" wx:for="{{elements}}" wx:key="name">
            <text class="wx-name" style="color: {{item.color}}">{{item.name}}</text>
            <view class="wx-track"><view class="wx-fill" style="width: {{item.value}}%; background: {{item.color}}"></view></view>
            <text class="wx-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <!-- 大运 -->
      <view class="section-card mt-5">
        <text class="section-title">大运排布（点击查看详解）</text>
        <scroll-view class="dayun-scroll mt-3" scroll-x enable-flex>
          <view
            class="dayun-card {{item.hot ? 'active' : ''}}"
            wx:for="{{dayunList}}"
            wx:key="age"
            data-gz="{{item.gz}}"
            data-god="{{item.note}}"
            data-age="{{item.age}}"
            bindtap="onDayunDetail"
          >
            <text class="dayun-age">{{item.age}} 岁</text>
            <text class="dayun-gz text-primary">{{item.gz}}</text>
            <text class="dayun-note">{{item.note}}</text>
          </view>
        </scroll-view>
      </view>

      <!-- 流年 -->
      <view class="section-card mt-5" wx:if="{{liunian.length > 0}}">
        <text class="section-title">流年运势 · 逐年详解</text>
        <view class="liunian-list mt-3">
          <view class="ln-item" wx:for="{{liunian}}" wx:key="year">
            <view class="ln-left"></view>
            <view class="flex-1">
              <view class="flex items-center gap-2">
                <text class="ln-year">{{item.year}}</text>
                <text class="ln-ganzhi">{{item.ganzhi}}</text>
                <text class="ln-luck {{item.luck === '当前' ? 'primary' : ''}}">{{item.luck}}</text>
              </view>
              <text class="ln-text">{{item.text}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 神煞 -->
      <view class="section-card mt-5" wx:if="{{shensha.length > 0}}">
        <text class="section-title">神煞速览</text>
        <view class="shensha-grid mt-3">
          <view class="ss-card" wx:for="{{shensha}}" wx:key="name">
            <view class="flex items-center justify-between">
              <text class="ss-name">{{item.name}}</text>
              <text class="ss-pos">{{item.pos}}</text>
            </view>
            <text class="ss-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 命格标签 -->
      <view class="section-card mt-5" wx:if="{{minggeTags.length > 0}}">
        <text class="section-title">命格标签</text>
        <view class="mg-tags mt-3">
          <text class="mg-tag" wx:for="{{minggeTags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <!-- 生活建议 -->
      <view class="section-card mt-5">
        <view class="flex items-center justify-between">
          <text class="section-title">多场景命理速读</text>
          <navigator url="/pages/reading/reading" class="detail-link">详细解读 →</navigator>
        </view>
        <view class="life-grid mt-3">
          <navigator url="/pages/reading/reading" class="life-card" wx:for="{{lifeCards}}" wx:key="title">
            <text class="life-icon">{{item.emoji}}</text>
            <text class="life-title">{{item.title}}</text>
            <text class="life-hint">点击查看 AI 详解 →</text>
          </navigator>
        </view>
      </view>

      <!-- 开运商城入口 -->
      <view class="shop-entry mt-5">
        <view class="flex items-center gap-3">
          <text class="shop-icon">✦</text>
          <view class="flex-1">
            <text class="shop-title">AI 开运手串推荐</text>
            <text class="shop-desc">基于命盘喜用神智能推荐</text>
          </view>
        </view>
        <navigator url="/pages/shop/shop" open-type="switchTab" class="shop-btn">进入开运商城</navigator>
      </view>

      <!-- AI 八字深度分析报告 -->
      <view class="section-card mt-5">
        <view class="flex items-center gap-2">
          <text style="font-size:36rpx">✨</text>
          <view>
            <text class="section-title">AI 八字深度分析报告</text>
            <text class="section-sub" wx:if="{{reportLoading}}">AI 正在分析命盘...</text>
            <text class="section-sub" wx:elif="{{report}}">基于八字排盘 · AI 通俗解读</text>
            <text class="section-sub" wx:elif="{{reportError}}">AI 分析暂不可用</text>
            <text class="section-sub" wx:else>准备中...</text>
          </view>
        </view>
        <view wx:if="{{reportLoading}}" class="loading-wrap py-4">
          <text class="animate-spin" style="font-size:48rpx;color:#8b5cf6">⟳</text>
          <text style="font-size:26rpx;color:#6b7280;margin-top:16rpx">枢机正在细细解读你的命盘...</text>
        </view>
        <view wx:elif="{{report}}" class="mt-3">
          <view class="report-section" wx:for="{{reportSections}}" wx:key="key">
            <view class="rs-header"><text class="rs-icon">{{item.icon}}</text><text class="rs-title">{{item.title}}</text></view>
            <rich-text class="rs-content" nodes="{{item.nodes}}"></rich-text>
          </view>
        </view>
        <view wx:elif="{{reportError}}" class="mt-3">
          <text style="color:#6b7280;font-size:26rpx;text-align:center;display:block;padding:32rpx">AI 分析暂不可用，以下为基础排盘数据</text>
        </view>
      </view>

      <!-- 我的八字命理图 -->
      <view class="section-card mt-5" id="fateChart">
        <view class="flex items-center justify-between mb-3">
          <text class="section-title">🖼️ 我的八字命理图</text>
          <text style="font-size:22rpx;color:#6b7280">可保存 / 分享</text>
        </view>
        <view class="fate-chart-card">
          <view class="fc-head"><text class="fc-brand">YUN SHU YI GUAN</text><text class="fc-brand">云枢易馆</text></view>
          <text class="fc-name">{{formName}} · 八字命理</text>
          <text class="fc-meta">{{formGender === '男' ? '乾造' : '坤造'}} · {{formDate}} {{formTime}}</text>
          <view class="fc-pillars">
            <view class="fcp-row"><text class="fcp-label"></text><text class="fcp-hdr" wx:for="{{pillars}}" wx:key="label">{{item.label}}</text></view>
            <view class="fcp-row"><text class="fcp-label">干</text><text class="fcp-gan" wx:for="{{pillars}}" wx:key="label" style="color:{{item.ganColor}}">{{item.gan}}</text></view>
            <view class="fcp-row"><text class="fcp-label">支</text><text class="fcp-zhi" wx:for="{{pillars}}" wx:key="label" style="color:{{item.zhiColor}}">{{item.zhi}}</text></view>
          </view>
          <view class="fc-elements">
            <view class="fce-item" wx:for="{{elements}}" wx:key="name"><text style="font-size:24rpx;color:{{item.color}}">{{item.name}}</text><text style="font-size:18rpx;color:rgba(255,255,255,.5)">{{item.value}}</text></view>
          </view>
          <view class="fc-info"><text>日元 {{rizhuLabel}} · 格局：{{zhengge || '—'}}</text></view>
          <view class="fc-footer"><text class="fc-ftext">古法藏枢机 · AI 解流年</text><text class="fc-qr">QR</text></view>
        </view>
        <view class="flex gap-2 mt-3">
          <button class="btn-save" bindtap="onSaveFateChart">💾 保存命理图</button>
          <button class="btn-share" bindtap="onShareFateChart">📤 分享给好友</button>
        </view>
      </view>
    </view>
  </block>

  <!-- 大运详情弹窗 -->
  <ui-dialog
    visible="{{dayunDialogVisible}}"
    title="{{dayunDialogData.age}}岁 · 大运「{{dayunDialogData.gz}}」"
    description="{{dayunDialogData.god}}"
    bindclose="onCloseDayunDetail"
  >
    <view class="dayun-dialog-body">
      <block wx:if="{{dayunLoading}}">
        <view class="loading-wrap">
          <text class="animate-spin" style="font-size:48rpx;color:var(--primary);margin-bottom:16rpx">⟳</text>
          <text>AI 正在解读这段大运...</text>
        </view>
      </block>
      <block wx:else>
        <rich-text nodes="{{dayunAnalysisNodes}}"></rich-text>
      </block>
    </view>
  </ui-dialog>
</view>
