.page { background-color: #f5f2ed; min-height: 100vh; }
.header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20rpx; }
.header-title { font-size: 40rpx; font-weight: 600; }
.post-btn {
  padding: 16rpx 32rpx; border-radius: 9999rpx;
  background: var(--primary); color: var(--primary-foreground);
  font-size: 28rpx; border: none;
}

.tab-bar { white-space: nowrap; padding-bottom: 32rpx; }
.tab-item {
  display: inline-block; padding: 12rpx 32rpx; margin-right: 16rpx;
  border-radius: 9999rpx; font-size: 24rpx;
  background: var(--card); color: var(--muted-foreground);
}
.tab-item.active { background: var(--primary); color: var(--primary-foreground); }

.post-list { padding-bottom: 160rpx; }
.loading-text, .empty-text { text-align: center; padding: 128rpx 0; font-size: 28rpx; color: var(--muted-foreground); }

.post-card { padding: 32rpx; border-radius: 32rpx; background: var(--card); box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04); margin-bottom: 24rpx; }
.post-avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: linear-gradient(135deg, #d94e3c, #c0392b); color: #ffffff;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.post-author { font-size: 28rpx; font-weight: 500; }
.post-meta { font-size: 22rpx; color: var(--muted-foreground); display: block; }
.post-title { font-size: 32rpx; font-weight: 500; margin-top: 24rpx; display: block; }
.post-content { font-size: 28rpx; color: var(--muted-foreground); line-height: 1.8; margin-top: 8rpx; display: block; }

.post-images { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 16rpx; }
.post-img { width: 100%; border-radius: 20rpx; border: 2rpx solid var(--border); }
.post-img.single { grid-column: span 2; max-height: 480rpx; }

.post-actions { display: flex; align-items: center; gap: 40rpx; margin-top: 24rpx; font-size: 24rpx; color: var(--muted-foreground); }
.action-btn { display: flex; align-items: center; gap: 8rpx; }
.action-btn .liked { color: var(--cinnabar); }

/* 预览 */
.preview-overlay {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(0,0,0,0.85);
  display: flex; align-items: center; justify-content: center; padding: 40rpx;
}
.preview-img { max-width: 100%; max-height: 85vh; border-radius: 24rpx; }

/* 发帖弹窗 */
.editor-overlay {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(0,0,0,0.4);
  display: flex; align-items: flex-end; justify-content: center;
}
.editor-panel {
  width: 100%; max-width: 600rpx; padding: 40rpx;
  background: var(--card); border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 48rpx rgba(0,0,0,0.12);
  max-height: 90vh; overflow-y: auto;
}
.editor-title { font-size: 36rpx; font-weight: 600; }
.editor-close { font-size: 36rpx; color: var(--muted-foreground); }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

.cat-tag {
  padding: 8rpx 24rpx; border-radius: 9999rpx;
  background: var(--muted); font-size: 24rpx; color: var(--muted-foreground);
}
.cat-tag.active { background: var(--primary); color: var(--primary-foreground); }

.form-input {
  width: 100%; padding: 24rpx 32rpx; border: 2rpx solid var(--border);
  border-radius: 24rpx; font-size: 28rpx; box-sizing: border-box;
}
.form-textarea {
  width: 100%; padding: 24rpx 32rpx; border: 2rpx solid var(--border);
  border-radius: 24rpx; font-size: 28rpx; height: 200rpx; box-sizing: border-box;
}

.img-pick-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; overflow-x: auto; }
.img-pick-item { position: relative; flex-shrink: 0; }
.img-pick-thumb { width: 160rpx; height: 160rpx; border-radius: 20rpx; border: 2rpx solid var(--border); }
.img-pick-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--cinnabar); color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.add-img-btn {
  padding: 16rpx 24rpx; border-radius: 16rpx; border: 2rpx dashed rgba(139,92,246,0.5);
  font-size: 24rpx; color: var(--primary); background: transparent;
}
.img-count { font-size: 22rpx; color: var(--muted-foreground); }

.publish-btn {
  width: 100%; padding: 28rpx; border-radius: 24rpx;
  background: var(--primary); color: var(--primary-foreground);
  font-size: 28rpx; font-weight: 500; border: none;
}
.publish-btn[disabled] { opacity: 0.6; }
