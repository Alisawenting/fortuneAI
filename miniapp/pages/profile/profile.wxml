<view class="page" style="padding-top:{{navBarHeight}}px;padding-bottom:120rpx">
  <view class="header px-5">
    <view class="flex items-center gap-4">
      <view class="avatar">{{userAvatar}}</view>
      <view class="flex-1">
        <text class="user-name">{{displayName}}</text>
        <text class="user-handle">{{username}}</text>
        <view class="member-badge" wx:if="{{isMember}}">👑 枢机会员</view>
        <button class="login-btn" wx:elif="{{!loggedIn}}" bindtap="onLogin">登录 / 注册</button>
      </view>
    </view>

    <navigator url="/pages/member/member" class="member-card" wx:if="{{loggedIn}}">
      <text>👑</text>
      <view class="flex-1">
        <text class="member-title">开通枢机会员</text>
        <text class="member-desc">无限 AI 问答 · 全场景深度解读</text>
      </view>
      <text>→</text>
    </navigator>
  </view>

  <!-- 社交数据 -->
  <view class="section-card mx-5">
    <text class="section-title">社交</text>
    <view class="social-grid">
      <navigator url="/pages/community/community" class="social-stat">
        <text class="stat-num">{{myPostCount}}</text>
        <text class="stat-label">我的帖子</text>
      </navigator>
      <navigator url="/pages/bookmarks/bookmarks" class="social-stat">
        <text class="stat-num">{{myBookmarkCount}}</text>
        <text class="stat-label">收藏</text>
      </navigator>
      <view class="social-stat">
        <text class="stat-num">{{friendCount}}</text>
        <text class="stat-label">好友</text>
      </view>
    </view>
    <view class="social-sub">
      <view class="social-sub-item"><text class="stat-num-sm">{{followCount}}</text><text>关注</text></view>
      <view class="social-sub-item"><text class="stat-num-sm">{{followerCount}}</text><text>粉丝</text></view>
    </view>
  </view>

  <!-- 菜单组 -->
  <view class="menu-group mx-5" wx:for="{{menuGroups}}" wx:key="title">
    <text class="menu-group-title">{{item.title}}</text>
    <view class="menu-list">
      <navigator class="menu-item" wx:for="{{item.items}}" wx:for-item="mi" wx:key="label" url="{{mi.to}}">
        <text class="menu-icon">{{mi.icon}}</text>
        <text class="menu-label flex-1">{{mi.label}}</text>
        <text class="menu-right" wx:if="{{mi.right}}">{{mi.right}}</text>
        <text class="menu-arrow">→</text>
      </navigator>
    </view>
  </view>

  <button class="logout-btn mx-5" wx:if="{{loggedIn}}" bindtap="onLogout">退出登录</button>

  <view class="footer">
    <text>云枢易馆 · 古法藏枢机，AI 解流年</text>
    <text>✦</text>
  </view>
</view>
