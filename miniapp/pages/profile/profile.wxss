.page { background-color: #f5f2ed; min-height: 100vh; }
.header { padding-bottom: 32rpx; }
.avatar {
  width: 128rpx; height: 128rpx; border-radius: 32rpx;
  background: linear-gradient(135deg, #d94e3c, #c0392b); color: #ffffff;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 600;
}
.user-name { font-size: 36rpx; font-weight: 600; display: block; }
.user-handle { font-size: 24rpx; color: #6b7280; display: block; }
.member-badge {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 8rpx 16rpx; border-radius: 9999rpx;
  background: #ffffff; font-size: 22rpx; color: #c49a3c;
  margin-top: 8rpx;
}
.login-btn {
  display: inline-flex; padding: 8rpx 16rpx; border-radius: 9999rpx;
  background: rgba(139,92,246,0.1); font-size: 22rpx; color: #8b5cf6;
  border: none; margin-top: 8rpx;
}

.member-card {
  display: flex; align-items: center; gap: 24rpx;
  margin-top: 40rpx; padding: 32rpx; border-radius: 32rpx;
  background: #1f2937; color: white;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}
.member-title { font-size: 28rpx; font-weight: 500; display: block; }
.member-desc { font-size: 22rpx; opacity: 0.8; display: block; }

.mx-5 { margin-left: 40rpx; margin-right: 40rpx; }

/* 社交数据 */
.social-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24rpx; margin-bottom: 24rpx; }
.social-stat {
  padding: 24rpx; border-radius: 24rpx;
  background: #f3f4f6; text-align: center;
}
.stat-num { font-size: 40rpx; font-weight: 600; color: #8b5cf6; display: block; }
.stat-num-sm { font-size: 32rpx; font-weight: 600; display: block; }
.stat-label { font-size: 22rpx; color: #6b7280; margin-top: 8rpx; display: block; }
.social-sub { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.social-sub-item {
  padding: 24rpx; border-radius: 24rpx;
  background: #f3f4f6; text-align: center;
  font-size: 22rpx; color: #6b7280;
}

/* 菜单 */
.menu-group { margin-bottom: 32rpx; }
.menu-group-title { font-size: 24rpx; color: #6b7280; padding: 0 8rpx; margin-bottom: 16rpx; display: block; }
.menu-list { border-radius: 24rpx; background: #ffffff; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04); overflow: hidden; }
.menu-item {
  display: flex; align-items: center; gap: 24rpx;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid rgba(0,0,0,0.08);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 32rpx; }
.menu-label { font-size: 28rpx; }
.menu-right { font-size: 24rpx; color: #6b7280; }
.menu-arrow { font-size: 24rpx; color: #6b7280; }

.logout-btn {
  padding: 28rpx; border-radius: 24rpx;
  border: 2rpx solid rgba(0,0,0,0.08); background: #ffffff;
  font-size: 28rpx; color: #6b7280; text-align: center;
}

.footer {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 32rpx; font-size: 22rpx; color: #6b7280;
}
