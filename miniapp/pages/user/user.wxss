.page { background-color: #f5f2ed; min-height: 100vh; }
.header { display: flex; align-items: center; justify-content: space-between; padding-top: 20rpx; padding-bottom: 20rpx; }
.back-btn { width: 72rpx; height: 72rpx; }
.header-title { font-size: 32rpx; font-weight: 500; }

.profile { text-align: center; padding: 40rpx 0; }
.avatar {
  width: 128rpx; height: 128rpx; border-radius: 32rpx;
  background: linear-gradient(135deg, #d94e3c, #c0392b); color: #ffffff;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 600; margin: 0 auto;
}
.name { font-size: 36rpx; font-weight: 600; display: block; margin-top: 24rpx; }
.handle { font-size: 24rpx; color: var(--muted-foreground); display: block; margin-top: 4rpx; }
.stats { display: flex; justify-content: center; gap: 64rpx; margin-top: 32rpx; }
.stat { text-align: center; font-size: 24rpx; color: var(--muted-foreground); }
.stat-n { font-size: 36rpx; font-weight: 600; color: var(--primary); display: block; }

.posts { padding-bottom: 120rpx; }
.posts-title { font-size: 28rpx; font-weight: 500; display: block; margin-bottom: 24rpx; }
.empty-text { text-align: center; padding: 80rpx 0; font-size: 28rpx; color: var(--muted-foreground); display: block; }
.post-card {
  padding: 32rpx; border-radius: 24rpx;
  background: var(--card); box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 16rpx;
}
.post-title { font-size: 30rpx; font-weight: 500; display: block; }
.post-content { font-size: 28rpx; color: var(--muted-foreground); line-height: 1.8; margin-top: 8rpx; display: block; }
.post-meta { font-size: 22rpx; color: var(--muted-foreground); margin-top: 12rpx; display: block; }
